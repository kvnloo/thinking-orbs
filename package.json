{
  "name": "thinking-orbs",
  "version": "0.3.1",
  "description": "Dotted thought-orb loading indicators for AI & agent UIs — nine tuned states, two sizes, auto dark/light",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.es.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./engine": {
      "import": {
        "types": "./dist/engine/index.d.ts",
        "default": "./dist/engine.es.js"
      },
      "require": {
        "types": "./dist/engine/index.d.ts",
        "default": "./dist/engine.cjs"
      }
    },
    "./tui": {
      "import": {
        "types": "./dist/tui/index.d.ts",
        "default": "./dist/tui.es.js"
      },
      "require": {
        "types": "./dist/tui/index.d.ts",
        "default": "./dist/tui.cjs"
      }
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "browser": "./dist/native/index.js",
      "react-native": "./dist/native/index.native.js",
      "default": "./dist/native/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "native.js",
    "native.native.js",
    "native.d.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite --config vite.config.demo.ts",
    "build": "vite build && vite build --config vite.config.native.ts",
    "build:demo": "vite build --config vite.config.demo.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:native": "tsc -p tsconfig.native.json --noEmit",
    "test": "tsx --test test/*.test.ts && vitest run",
    "test:browser": "playwright test",
    "verify:render-size": "tsx scripts/verify-render-size.ts",
    "spec": "tsx scripts/extract-spec.ts && tsx scripts/extract-golden.ts",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-native": ">=0.73.0",
    "/react-native-skia": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": { "optional": true },
    "react-native": { "optional": true },
    "/react-native-skia": { "optional": true }
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "clsx": "^2.1.1",
    "jsdom": "^26.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "^0.75.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.0",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "react",
    "loading",
    "loader",
    "spinner",
    "ai",
    "agent",
    "llm",
    "canvas",
    "animation",
    "dark-mode"
  ],
  "author": "Jakub Antalik",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jakubantalik/thinking-orbs.git"
  },
  "bugs": {
    "url": "https://github.com/Jakubantalik/thinking-orbs/issues"
  },
  "homepage": "https://orbs.jakubantalik.com"
}
